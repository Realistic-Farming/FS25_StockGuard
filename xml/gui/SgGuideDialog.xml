<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    Stock Guard Field Guide - Field Guide
    3 tabs. Content is built in Lua and swapped per tab (one column pair).
    Chrome copied from FdGuideDialog, which copied SoilGuideDialog, so every Realistic Farming guide
    reads the same. Profiles are declared here so this dialog carries its own and depends on no door file.
    Controller: SgGuideDialog
-->
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
  <GuiElement profile="newLayer"/>
  <Bitmap profile="dialogFullscreenBg" id="dialogBg"/>

  <GuiElement profile="sgGuide_bg" id="dialogElement">

    <ThreePartBitmap profile="fs25_dialogBgMiddle"/>
    <ThreePartBitmap profile="fs25_dialogBgTop"/>
    <ThreePartBitmap profile="fs25_dialogBgBottom"/>

    <GuiElement profile="fs25_dialogContentContainer">

      <Text profile="fs25_dialogTitle" id="sgGuide_title" text="Stock Guard Field Guide" position="0px -28px"/>

      <BoxLayout profile="sgGuide_tabRow" position="0px -66px">
        <Button profile="sgGuide_tab" id="sgGuide_tab1" text="Overview" onClick="onClickTab1"/>
        <Button profile="sgGuide_tab" id="sgGuide_tab2" text="Reading The Page" onClick="onClickTab2"/>
        <Button profile="sgGuide_tab" id="sgGuide_tab3" text="Doing Things" onClick="onClickTab3"/>
      </BoxLayout>

      <Text profile="sgGuide_subtitle" id="sgGuide_subtitle" text="" position="0px -110px"/>

      <GuiElement profile="sgGuide_colPanel" position="-253px -138px">
        <Bitmap profile="sgGuide_colBg" position="0px 0px"/>
        <BoxLayout profile="sgGuide_col" id="sgGuide_col1" position="0px -8px"/>
      </GuiElement>

      <GuiElement profile="sgGuide_colPanel" position="253px -138px">
        <Bitmap profile="sgGuide_colBgAlt" position="0px 0px"/>
        <BoxLayout profile="sgGuide_col" id="sgGuide_col2" position="0px -8px"/>
      </GuiElement>

    </GuiElement>

    <BoxLayout profile="fs25_dialogButtonBox">
      <Button profile="buttonOK" text="Close" onClick="onClickClose"/>
    </BoxLayout>

  </GuiElement>

  <GUIProfiles>

    <Profile name="sgGuide_bg" extends="fs25_dialogBg">
      <size value="1120px 930px"/>
    </Profile>

    <Profile name="sgGuide_tabRow" extends="emptyPanel" with="anchorTopCenter">
      <size value="960px 38px"/>
      <flowDirection value="horizontal"/>
      <elementSpacing value="10px"/>
    </Profile>

    <!-- The guide tabs and Close stay buttonOK: dialog chrome, not Esc overlay chips, so the chip law
         does not apply to them. Three tabs, so each is wider than the Depot guide's five. -->
    <Profile name="sgGuide_tab" extends="buttonOK">
      <size value="300px 36px"/>
      <textSize value="11px"/>
      <textUpperCase value="true"/>
    </Profile>

    <Profile name="sgGuide_subtitle" extends="fs25_textDefault" with="anchorTopCenter">
      <size value="960px 22px"/>
      <textSize value="11px"/>
      <textColor value="0.85 0.75 0.30 0.90"/>
      <textAlignment value="center"/>
    </Profile>

    <Profile name="sgGuide_colPanel" extends="emptyPanel" with="anchorTopCenter">
      <size value="510px 630px"/>
    </Profile>
    <Profile name="sgGuide_colBg" extends="baseReference" with="anchorTopCenter">
      <size value="510px 630px"/>
      <imageColor value="0.08 0.08 0.12 0.90"/>
    </Profile>
    <Profile name="sgGuide_colBgAlt" extends="baseReference" with="anchorTopCenter">
      <size value="510px 630px"/>
      <imageColor value="0.06 0.10 0.14 0.90"/>
    </Profile>

    <Profile name="sgGuide_col" extends="emptyPanel" with="anchorTopCenter">
      <size value="494px 614px"/>
      <flowDirection value="vertical"/>
      <useFullVisibility value="false"/>
      <alignmentX value="left"/>
      <elementSpacing value="3px"/>
    </Profile>

    <Profile name="sgGuide_colHeader" extends="fs25_textDefault" with="anchorTopLeft">
      <size value="472px 22px"/>
      <textSize value="15px"/>
      <textBold value="true"/>
      <textUpperCase value="true"/>
      <textColor value="1 0.8 0.2 1"/>
      <textAlignment value="left"/>
    </Profile>
    <Profile name="sgGuide_colBody" extends="fs25_textDefault" with="anchorTopLeft">
      <size value="472px 19px"/>
      <textSize value="14px"/>
      <textColor value="1 1 1 1"/>
      <textAlignment value="left"/>
    </Profile>
    <Profile name="sgGuide_colSpacer" extends="fs25_textDefault" with="anchorTopLeft">
      <size value="472px 10px"/>
      <textSize value="8px"/>
      <textColor value="0.0 0.0 0.0 0.0"/>
    </Profile>

  </GUIProfiles>
</GUI>
